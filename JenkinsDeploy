pipeline {
    agent { label 'prod' }

    triggers {
        githubPush()
        }
    environment {
        K8S_DIR    = "K8"
        }
    stages {
        
        stage('Deploy to K8 cluster') {
           steps {
                script {
                    echo "Deploying..."
                    sh """
                        kubectl apply -f ${K8S_DIR}/deployment.yml
                        kubectl apply -f ${K8S_DIR}/service.yml
                    """
                }
            }
        }

        stage('Test Deployment') {
            steps {
                script {
                    echo "test deployment.."
                    sh """
                        sleep 10
                        kubectl rollout status deployment/onlineshop --timeout=120s
                        kubectl wait --for=condition=Ready pod -l app=pdd --timeout=120s
                    """
                }
            }
        }
    }
        
    post {
        success {
            echo "Deployment Successfull"
        }
        failure {
            echo "Deployment failed"
        }
    }
}
        
